# Copy this file to /etc/proteinhub.env on the server and replace every
# placeholder value before starting ProteinHub.

PROTEINHUB_DATABASE_URL=postgresql://proteinhub:replace-me@127.0.0.1:5432/proteinhub
PROTEINHUB_ARTIFACT_STORAGE_BACKEND=database

PROTEINHUB_JWT_SECRET=replace-with-a-long-random-secret
PROTEINHUB_NICEGUI_STORAGE_SECRET=replace-with-another-long-random-secret
PROTEINHUB_ADMIN_EMAILS=admin@example.com
PROTEINHUB_PUBLIC_BASE_URL=http://10.6.108.62

PROTEINHUB_DATA_DIR=/var/lib/proteinhub
PROTEINHUB_STORAGE_DIR=/var/lib/proteinhub/storage

# Optional: xiaopang/domesticator optimization used by batch translation.
# Plain reverse translation uses Python dependencies and does not require this.
# PROTEINHUB_LEGACY_DOMESTICATOR_PYTHON=/opt/proteinhub-tools/domesticator-env/bin/python
# PROTEINHUB_LEGACY_DOMESTICATOR_SCRIPT=/opt/proteinhub-tools/domesticator/domesticator.py
# PROTEINHUB_LEGACY_DOMESTICATOR_DATABASE=/opt/proteinhub-tools/domesticator/database
# PROTEINHUB_LEGACY_DOMESTICATOR_TIMEOUT_SECONDS=300

# Optional: AKTA zip rendering.
# PROTEINHUB_AKTA_HAP_PYTHON=/opt/proteinhub-tools/akta/bin/python
# PROTEINHUB_AKTA_HAP_SCRIPT=/opt/proteinhub-tools/akta/akta_hap.py
# PROTEINHUB_AKTA_HAP_TIMEOUT_SECONDS=120

# Optional: backup scripts.
PROTEINHUB_BACKUP_DIR=/var/backups/proteinhub
PROTEINHUB_BACKUP_RETENTION_DAYS=14
# PROTEINHUB_REMOTE_BACKUP_TARGET=user@backup-host:/path/to/proteinhub-backups/dumps/
# PROTEINHUB_REMOTE_BACKUP_SSH_KEY=/var/lib/proteinhub/.ssh/proteinhub_backup
