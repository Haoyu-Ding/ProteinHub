[Unit]
Description=Backup ProteinHub PostgreSQL database
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=proteinhub
Group=proteinhub
WorkingDirectory=/opt/proteinhub
EnvironmentFile=/etc/proteinhub.env
Environment=PROTEINHUB_ENV_FILE=/etc/proteinhub.env
ExecStart=/opt/proteinhub/scripts/backup-postgres.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/proteinhub
UMask=0077
