[Unit]
Description=ProteinHub
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=proteinhub
Group=proteinhub
WorkingDirectory=/opt/proteinhub
EnvironmentFile=/etc/proteinhub.env
ExecStart=/opt/proteinhub/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/proteinhub /var/backups/proteinhub

[Install]
WantedBy=multi-user.target
